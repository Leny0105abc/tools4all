{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=server.js",
    "start": "node server.js",
    "preview": "vite preview",
    "test:audio-notes": "node --import tsx --test tests/auth.test.ts tests/audioNoteSummary.test.ts tests/audioNotesMp3.test.mjs tests/audioNotesStorage.test.ts tests/audioNotesTool.test.tsx tests/videoCompressor.test.ts",
    "clean": "rm -rf dist server.js server.js.map",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bgutils-js": "^4.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsdom": "^30.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
